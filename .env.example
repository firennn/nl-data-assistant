# Copy this file to .env and fill in your own values. Never commit .env.

# Path to the SQLite database (relative to the project root).
DB_PATH=data/olist.db

# Primary LLM provider: gemini | groq
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=

# Optional fallback provider, used only when the primary is rate limited or unavailable.
# Leave LLM_FALLBACK_PROVIDER empty to disable.
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_API_KEY=

# How many times the agent retries a failed SQL query (with the error message).
AGENT_MAX_RETRIES=2
